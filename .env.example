# 企微自建应用回调桥 v2.1 配置模板
# 在 NAS 上直接填，绝不要把填好的文件发到聊天里。
# 各项从哪里取，见 README.md。

# 企业微信管理后台 → 我的企业 → 企业信息 → 企业 ID
WECOM_CORPID=

# 应用管理 → 自建应用 → 点进应用 → Secret（点“查看”）
WECOM_SECRET=

# 同一页面的 AgentId（新建应用后产生，见 README 第 1 步）
WECOM_AGENTID=

# 应用详情页 → 接收消息 → 设置 API 接收 → Token（自己定一串字符）
WECOM_TOKEN=

# 同一页面 → EncodingAESKey（点“随机生成”，43 位）
WECOM_AESKEY=

# 能用这个桥的企微 userid，多个用英文逗号隔开，例如 WangDeWei
OWNER_USERIDS=

# 聊天后端（OpenAI 兼容接口），一般不用改
LLM_API_BASE=https://api.anyrouter.top/v1
LLM_API_KEY=
LLM_MODEL=muse-spark

# 企微里显示的助理名字
BOT_NAME=Marlowe

# 回调服务监听端口（改这里要同步改 docker-compose.yml 的端口映射和回调 URL）
WECOM_CALLBACK_PORT=18789

# ---- v2.1 新增：ESXi（可选）----
# 填了才能用 ESXi VM、重启 NAS；不填时相关功能回一句“未配置”。
# ESXi 主机地址（IP 或域名）
ESXI_HOST=
# ESXi 登录用户名，一般是 root
ESXI_USER=root
# ESXi 登录密码（或用下面的 key 文件，二选一；key 优先）
ESXI_PASSWORD=
# ESXi SSH 私钥路径（容器内路径，例如 /data/id_ed25519；见 README）
# ESXI_KEY_FILE=/data/id_ed25519
# NAS 这个 VM 在 ESXi 里的名字（或用 NAS_VM_ID 填数字 ID，二选一）
NAS_VM_NAME=
# NAS_VM_ID=

# ---- v2.1 新增：自我更新（可选）----
# GitHub 仓库，根目录放 wecom_callback.py，例如 wdw6733/wecom-callback-bridge
# 不填时菜单“检查更新”回一句“未配置”。
UPDATE_REPO=
UPDATE_BRANCH=main
# 私有仓库才填（只读权限的 token 即可）；公开仓库留空
# UPDATE_TOKEN=

# 本桥自己的容器名（容器管理/镜像检查里跳过自己）
SELF_CONTAINER_NAME=wecom-callback

# ---- v2.1 新增：主动告警、镜像检查（可选，默认都开）----
# 告警开关（1 开 / 0 关，也可以在企微里点告警卡片开关）
ALERT_ENABLED=1
# 告警检查间隔（秒，默认 300 = 5 分钟）
ALERT_INTERVAL_SEC=300
# 告警阈值：磁盘已用%、负载（核数×倍数）、内存已用%
ALERT_DISK_PCT=90
ALERT_LOAD_MULT=2.0
ALERT_MEM_PCT=92
# 同一种告警多久内只发一次（秒，默认 3600 = 1 小时）
ALERT_COOLDOWN_SEC=3600
# 容器镜像更新检查开关（1 开 / 0 关）
IMAGE_CHECK_ENABLED=1
# 镜像检查间隔（秒，默认 21600 = 6 小时）
IMAGE_CHECK_INTERVAL_SEC=21600
